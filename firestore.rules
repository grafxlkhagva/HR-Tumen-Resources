rules_version = '2';
// Teal HR — Firestore аюулгүй байдлын дүрмүүд.
// Roles болон collection-уудын эрхийн тайлбар: docs/FIRESTORE_ROLES.md

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Туслах функцууд ─────────────────────────────────────────────────
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Ажилтан мөн эсэх: employees/{uid} doc байгаа эсэхээр тогтооно.
    // Гадны хэрэглэгч (жолооч, захиалагч) Firebase Auth-д нэвтэрсэн ч employees
    // doc-гүй тул дотоод collection-уудад хүрэхгүй. isSignedIn()-ийг дотоод
    // өгөгдөл хамгаалахад ШУУД БҮҮ ХЭРЭГЛЭ — isEmployee() ашиглана.
    function isEmployee() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/employees/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/employees/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.get('role', 'employee') == 'admin';
    }

    function isTmsUser() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/employees/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.get('tmsAccess', false) == true;
    }

    function isTmsAllowed() {
      return isAdmin() || isTmsUser();
    }

    // ─── Driver Flutter app — Custom claim role='driver' дамжуулна ──────────
    function isDriver() {
      return isSignedIn() &&
             request.auth.token.get('role', '') == 'driver';
    }

    function getDriverId() {
      return request.auth.token.get('driverId', '');
    }

    function isOwnDriver(driverId) {
      return isDriver() && getDriverId() == driverId;
    }

    // ─── Захиалагчийн Flutter app — Custom claim role='customer' ────────────
    // Claims-ийг зөвхөн /api/mobile/v1/customer/auth/register (Admin SDK) оноодог.
    function isCustomer() {
      return isSignedIn() &&
             request.auth.token.get('role', '') == 'customer';
    }

    // Жолоочийн зөвхөн доорх (өөрийн) талбаруудыг шинэчлэх зөвшөөрнө.
    // Тогтмол талбарууд (firstName, lastName, license г.м) дисптатчер хийнэ.
    function driverOnlyFieldsChanged(newD, oldD) {
      return newD.diff(oldD).affectedKeys()
        .hasOnly(['fcmTokens', 'availability', 'lastSeenAt',
                  'lastLocation', 'acceptanceRadius', 'authUid', 'updatedAt']);
    }

    // Жолооч өөрийн transport-ын дотор аль талбар өөрчилж болохыг тогтооно.
    function driverTransportFieldsChanged(newD, oldD) {
      return newD.diff(oldD).affectedKeys()
        .hasOnly(['driverAcceptanceStatus', 'driverAcceptedAt',
                  'driverRejectedAt', 'driverRejectionReason',
                  'status', 'dispatchSteps', 'subTransports', 'updatedAt']);
    }

    function isNewsUser() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/employees/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.get('newsAccess', false) == true;
    }

    function isNewsAllowed() {
      return isAdmin() || isNewsUser();
    }

    function isHseUser() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/employees/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.get('hseAccess', false) == true;
    }

    function isHseAllowed() {
      return isAdmin() || isHseUser();
    }

    // Оноогдсон ажилтан өөрийн ID-г "танилцсан/хамрагдсан" массивт нэмэхийг л зөвшөөрнө.
    // assignField (жишээ tanilcahIds) дотор байгаа ажилтан signField (tanilcsanIds)-д
    // ЗӨВХӨН өөрийн uid-г нэмнэ — өөр талбар өөрчлөх, бусдын ID нэмэх/хасахыг хориглоно.
    function canSelfAck(assignField, signField) {
      return isSignedIn() &&
             request.auth.uid in resource.data.get(assignField, []) &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly([signField]) &&
             request.resource.data.get(signField, []).hasAll(resource.data.get(signField, [])) &&
             request.resource.data.get(signField, []).hasOnly(resource.data.get(signField, []).concat([request.auth.uid]));
    }

    function isCrmUser() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/employees/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.get('crmAccess', false) == true;
    }

    function isCrmAllowed() {
      return isAdmin() || isCrmUser();
    }

    // ─── TMS Тээврийн удирдлагын талбар түвшний баталгаажуулалт ─────────
    // Хортой client-аар сөрөг үнэ, буруу status, хэт том массив бичүүлэхээс
    // сэргийлнэ. Optional талбарууд байвал л шалгаж, байхгүй бол тойрно.
    function tmTransportValid(d) {
      return d.customerId is string
        && d.status in ['draft', 'planning', 'active', 'completed', 'cancelled']
        && (!('driverPrice' in d) || d.driverPrice == null || (d.driverPrice is number && d.driverPrice >= 0))
        && (!('customerPrice' in d) || d.customerPrice == null || (d.customerPrice is number && d.customerPrice >= 0))
        && (!('profitMarginPercent' in d) || d.profitMarginPercent == null || d.profitMarginPercent is number)
        && (!('subTransports' in d) || d.subTransports == null || (d.subTransports is list && d.subTransports.size() <= 200))
        && (!('financeTransactions' in d) || d.financeTransactions == null || (d.financeTransactions is list && d.financeTransactions.size() <= 500))
        && (!('contractServiceId' in d) || d.contractServiceId == null || d.contractServiceId is string)
        && (!('contractServiceIds' in d) || d.contractServiceIds == null || d.contractServiceIds is list);
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Анхны админ бүртгэх: signup нээлттэй үед employees тоолох боломжтой
    // Документ: system/signup_config { open: true|false }
    match /system/signup_config {
      allow read: if true;
      allow create: if !exists(/databases/$(database)/documents/system/signup_config);
      allow update, delete: if isAdmin();
    }

    // employees: нэвтэрсэн эсвэл signup нээлттэй үед унших (анхны админ шалгах).
    // Консолд "Error loading documents" гарах нь хэвийн: консол request.auth илгээдэггүй тул isSignedIn()=false.
    // Дэлгэрэнгүй: docs/FIRESTORE_ROLES.md хэсэг 5.
    match /employees/{employeeId} {
      // Гадны хэрэглэгч (жолооч/захиалагч) ажилтнуудын PII уншихгүй.
      allow read: if isEmployee() ||
        (exists(/databases/$(database)/documents/system/signup_config) &&
         get(/databases/$(database)/documents/system/signup_config).data.get('open', false) == true);
      // Үүсгэх: админ (шинэ ажилтан бүртгэх) эсвэл signup нээлттэй үед анхны
      // админ өөрийн doc-оо үүсгэнэ. isSignedIn() байсныг хатуужуулав —
      // өмнө нь ямар ч нэвтэрсэн хэрэглэгч өөртөө role='admin' doc үүсгэж
      // эрх ахиулах боломжтой байсан.
      allow create: if isAdmin() ||
        (isOwner(employeeId) &&
         exists(/databases/$(database)/documents/system/signup_config) &&
         get(/databases/$(database)/documents/system/signup_config).data.get('open', false) == true);
      // Owners can update their profile, but cannot change privileged fields.
      allow update: if isAdmin() || (
        isOwner(employeeId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'tmsAccess', 'newsAccess', 'questionnaireLocked'])
      );
    }
    
    // Questionnaire subcollection: employees can write only when not locked.
    match /employees/{employeeId}/questionnaire/{docId} {
      allow read: if isOwner(employeeId) || isAdmin();
      allow create, update, delete: if isAdmin() || (isOwner(employeeId) &&
        !get(/databases/$(database)/documents/employees/$(employeeId)).data.get('questionnaireLocked', false)
      );
    }

    // Subcollections of employees
    match /employees/{employeeId}/{subcollection}/{docId} {
       allow read: if (isEmployee() && isOwner(employeeId)) || isAdmin();
       // Avoid over-broad writes for sensitive subcollections that have their own rules.
       allow write: if ((isEmployee() && isOwner(employeeId)) || isAdmin()) &&
         !(subcollection in ['questionnaire', 'vacationRequests']);
    }

    // Onboarding / Offboarding процессууд
    match /onboarding_processes/{processId} {
      allow read: if isEmployee();
      allow write: if isAdmin();
    }
    match /{path=**}/offboarding_processes/{docId} {
      allow read: if isEmployee();
      allow write: if isAdmin();
    }

    match /employees/{employeeId}/point_profile/{docId} {
       allow read, write: if isEmployee();
    }

    // Allow mentors/buddies to update assigned programs (e.g. mark tasks as done)
    match /employees/{employeeId}/assignedPrograms/{programId} {
      allow read: if isEmployee();
      allow create, delete: if isAdmin();
      allow update: if isEmployee();
    }

    // --- Points & Social System Rules ---
    match /recognition_posts/{postId} {
      allow read, create: if isEmployee();
      allow update: if isEmployee() && (
        isAdmin() ||
        request.auth.uid == (resource.data.fromUserId) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
      );
      allow delete: if isAdmin() || (isEmployee() && request.auth.uid == (resource.data.fromUserId));
    }

    match /posts/{postId} {
      allow read: if isEmployee();
      allow create, delete: if isNewsAllowed();
      allow update: if isNewsAllowed() || 
                    (isEmployee() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']));
    }

    match /points_config/{docId} {
      allow read: if isEmployee();
      allow write: if isAdmin();
    }

    match /point_transactions/{txId} {
      allow read: if isEmployee() && (isAdmin() || request.auth.uid == resource.data.userId);
      allow create: if isEmployee();
    }

    match /rewards/{rewardId} {
      allow read: if isEmployee();
      allow write: if isAdmin();
    }

    match /redemption_requests/{requestId} {
      allow read: if isEmployee() && (isAdmin() || request.auth.uid == resource.data.userId);
      allow create: if isEmployee();
      allow update: if isAdmin();
    }

    match /budget_point_requests/{requestId} {
      allow create: if isEmployee();
      allow read, update, delete: if isEmployee() && (isAdmin() || request.auth.uid == resource.data.fromUserId);
    }



    // Vacation requests rules
    match /employees/{employeeId}/vacationRequests/{requestId} {
      allow read: if isEmployee();
      // Employee creates their own request (pending).
      allow create: if isOwner(employeeId) &&
        request.resource.data.employeeId == employeeId &&
        request.resource.data.status == 'PENDING';

      // Update rules:
      // - Admin: any
      // - Owner: cancel only (PENDING -> CANCELLED)
      // - Approver: approve/reject/return-to-pending with limited fields
      allow update: if isAdmin() ||
        (
          isOwner(employeeId) &&
          resource.data.status == 'PENDING' &&
          request.resource.data.status == 'CANCELLED' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decisionAt', 'updatedAt'])
        ) ||
        (
          isEmployee() &&
          request.auth.uid == resource.data.approverId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decisionAt', 'approvedAt', 'rejectionReason', 'updatedAt']) &&
          (
            // Approve
            (request.resource.data.status == 'APPROVED' &&
              request.resource.data.decisionAt is string &&
              request.resource.data.approvedAt is string &&
              (
                !request.resource.data.keys().hasAny(['rejectionReason']) ||
                request.resource.data.rejectionReason == null
              )
            )
            ||
            // Reject (reason required)
            (request.resource.data.status == 'REJECTED' &&
              request.resource.data.decisionAt is string &&
              request.resource.data.approvedAt is string &&
              request.resource.data.rejectionReason is string &&
              request.resource.data.rejectionReason.size() > 0
            )
            ||
            // Return to pending (clear decision fields)
            (request.resource.data.status == 'PENDING' &&
              (request.resource.data.decisionAt == null) &&
              (request.resource.data.approvedAt == null) &&
              (request.resource.data.rejectionReason == null)
            )
          )
        );

      // Delete: admin only (use cancel instead of delete)
      allow delete: if isAdmin();
    }
    
    // Company profile and branding settings
    match /company/{allPaths=**} {
      allow read: if isSignedIn() || true;
      allow write: if isAdmin();
    }

    // Company-wide policies can be read by any signed-in user, but only managed by admins.
    match /companyPolicies/{policyId} {
        allow read: if isEmployee();
        allow write: if isAdmin();
    }

    // Employee documents: employees can manage their own documents
    match /documents/{docId} {
      allow read: if isEmployee();
      allow create: if isEmployee() && (
        isAdmin() ||
        request.resource.data.metadata.employeeId == request.auth.uid
      );
      allow update: if isAdmin();
      allow delete: if isAdmin() || (
        isEmployee() &&
        resource.data.metadata.employeeId == request.auth.uid &&
        resource.data.metadata.get('uploadedBy', '') == 'employee'
      );
    }

    // Reference data (collections ending with 'Types', 'Levels', 'Statuses', etc.)
    // Зөвхөн АЖИЛТАН уншина — isSignedIn() байсныг isEmployee() болгож хатуужуулав.
    // Учир: жолооч/захиалагч апп-ын хэрэглэгчид Firebase Auth-д нэвтэрсэн байдаг тул
    // isSignedIn() нь tms_contracts, crm_* зэрэг нууц өгөгдлийг тэдэнд задалж байсан.
    // ⚠️ Firestore дүрэм UNION (OR) семантиктай тул энэ өргөн catch-all нь доор
    // тусад нь `if false` гэж хаасан мэдрэмтгий collection-уудыг ч задалдаг.
    // Тиймээс нууц collection-уудыг ЭНД шууд хасна (OTP hash задрахаас сэргийлнэ).
    match /{refCollection}/{docId} {
       allow read: if isEmployee() && refCollection != 'password_resets';
       allow write: if isAdmin() && refCollection != 'password_resets';
    }

    // All users can read departments, positions, and company info
    match /departments/{departmentId} {
      allow read: if isEmployee();
      allow write: if isAdmin();
    }
    
    match /positions/{positionId} {
      allow read: if isEmployee();
      allow write: if isAdmin();
    }


    // Onboarding program templates are managed by admins
    match /onboardingPrograms/{programId}/{document=**} {
       allow read: if isEmployee();
       allow write: if isAdmin();
    }

    match /newHires/{hireId} {
      allow read, write: if isAdmin();
    }

    // Байгууллагын үйлдлүүд (organization actions)
    match /organization_actions/{actionId} {
      allow read: if isEmployee();
      allow write: if isAdmin();
    }

    // Тохиргоо (settings/onboarding гэх мэт)
    match /settings/{docId} {
      allow read: if isEmployee();
      allow write: if isAdmin();
    }

    // Компанийн түүхэн үйл явдлууд
    match /companyHistory/{eventId} {
      allow read: if isEmployee();
      allow write: if isAdmin();
    }

    // company_profile (хэрэв тусгаар collection ашигласан бол)
    match /company_profile/{docId} {
      allow read: if isEmployee();
      allow write: if isAdmin();
    }

    // Attendance records can be created by the user, but likely only read by admins or managers
    match /attendance/{attendanceId} {
      allow create: if isEmployee() && isOwner(request.resource.data.employeeId);
      allow read, update: if isAdmin();
    }

    // The following comment is a special instruction for the backend to create an index.
    // Please do not modify or remove it.
    // FIRESTORE_INDEX: COLLECTION_GROUP(timeOffRequests) ASC(status)

    // Collection Group rules
    match /{path=**}/assignedPrograms/{docId} {
        allow read: if isEmployee();
        allow write: if isAdmin();
    }

    match /{path=**}/timeOffRequests/{docId} {
        allow read: if isEmployee();
        allow write: if isAdmin();
    }

    match /{path=**}/vacationRequests/{docId} {
        allow read: if isEmployee();

        // Create: owner creates pending request
        allow create: if isEmployee() &&
          request.auth.uid == request.resource.data.employeeId &&
          request.resource.data.status == 'PENDING';

        // Update: mirror `employees/{employeeId}/vacationRequests/{requestId}`
        allow update: if isAdmin() ||
          (
            isEmployee() &&
            request.auth.uid == resource.data.employeeId &&
            resource.data.status == 'PENDING' &&
            request.resource.data.status == 'CANCELLED' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decisionAt', 'updatedAt'])
          ) ||
          (
            isEmployee() &&
            request.auth.uid == resource.data.approverId &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decisionAt', 'approvedAt', 'rejectionReason', 'updatedAt']) &&
            (
              (request.resource.data.status == 'APPROVED' &&
                request.resource.data.decisionAt is string &&
                request.resource.data.approvedAt is string &&
                (
                  !request.resource.data.keys().hasAny(['rejectionReason']) ||
                  request.resource.data.rejectionReason == null
                )
              )
              ||
              (request.resource.data.status == 'REJECTED' &&
                request.resource.data.decisionAt is string &&
                request.resource.data.approvedAt is string &&
                request.resource.data.rejectionReason is string &&
                request.resource.data.rejectionReason.size() > 0
              )
              ||
              (request.resource.data.status == 'PENDING' &&
                (request.resource.data.decisionAt == null) &&
                (request.resource.data.approvedAt == null) &&
                (request.resource.data.rejectionReason == null)
              )
            )
          );

        allow delete: if isAdmin();
    }
    
    
    // --- Employment Relations Module Rules ---
    
    // Document Types - Admin only
    match /er_document_types/{typeId} {
      allow read: if isEmployee();
      allow write: if isAdmin();
    }
    
    // Templates - Admin only for write, all signed-in users can read active templates
    match /er_templates/{templateId} {
      allow read: if isEmployee();
      allow write: if isAdmin();
    }
    
    match /er_workflows/{workflowId} {
      allow read: if isEmployee();
      allow write: if isAdmin();
    }

    // ER процессын баримтын төрлүүд (employment-relations settings)
    match /er_process_document_types/{typeId} {
      allow read: if isEmployee();
      // Admins manage settings. Signed-in users may only bump the numbering counter
      // in a tightly validated way (so document creation can allocate numbers).
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isEmployee() && (
        // Only allow updating counter-related fields
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'currentNumber',
          'lastNumberYear',
          'lastNumberMonth',
          'lastNumberDay',
          'updatedAt'
        ]) &&
        // Ensure numeric fields are numbers
        (request.resource.data.currentNumber is int || request.resource.data.currentNumber is number) &&
        (request.resource.data.lastNumberYear is int || request.resource.data.lastNumberYear is number) &&
        (request.resource.data.lastNumberMonth is int || request.resource.data.lastNumberMonth is number) &&
        (request.resource.data.lastNumberDay is int || request.resource.data.lastNumberDay is number) &&
        // Ensure date parts match request.time
        request.resource.data.lastNumberYear == request.time.year &&
        request.resource.data.lastNumberMonth == request.time.month &&
        request.resource.data.lastNumberDay == request.time.day &&
        // Ensure counter increments by 1 OR resets to startNumber based on resetPeriod
        (
          // Increment path
          request.resource.data.currentNumber == (resource.data.currentNumber + 1)
          ||
          // Reset path (yearly/monthly/daily) to startNumber
          (
            request.resource.data.currentNumber ==
              (resource.data.numberingConfig.startNumber is int ? resource.data.numberingConfig.startNumber : 1)
            &&
            (
              resource.data.numberingConfig.resetPeriod == 'yearly' && resource.data.lastNumberYear != request.time.year
              ||
              resource.data.numberingConfig.resetPeriod == 'monthly' && (
                resource.data.lastNumberYear != request.time.year || resource.data.lastNumberMonth != request.time.month
              )
              ||
              resource.data.numberingConfig.resetPeriod == 'daily' && (
                resource.data.lastNumberYear != request.time.year ||
                resource.data.lastNumberMonth != request.time.month ||
                resource.data.lastNumberDay != request.time.day
              )
            )
          )
        )
      ));
    }

    // Documents - Complex rules based on status and role
    match /er_documents/{documentId} {
      // Read access:
      // - Creator can always read their own documents
      // - Reviewers can read documents they need to review
      // - Admins can read all
      allow read: if isEmployee() && (
        isAdmin() ||
        request.auth.uid == resource.data.creatorId ||
        request.auth.uid == resource.data.employeeId ||
        request.auth.uid in resource.data.get('reviewers', []) ||
        (exists(/databases/$(database)/documents/employees/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.get('positionId', '') in resource.data.get('reviewers', []))
      );
      
      // Create: Any signed-in user can create documents
      allow create: if isEmployee();
      
      // Update access:
      // - Creator can update their own DRAFT documents
      // - Reviewers can update approvalStatus when document is IN_REVIEW
      // - Creator can finalize approval when status is REVIEWED
      // - Admins can update anything
      allow update: if isEmployee() && (
        isAdmin() ||
        // Creator updating their own draft
        (request.auth.uid == resource.data.creatorId && resource.data.status == 'DRAFT') ||
        // Creator finalizing approval when all reviewers approved
        (request.auth.uid == resource.data.creatorId && resource.data.status == 'REVIEWED' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
        // Admin/reviewer/creator sending SIGNED doc to employee for acknowledgement
        (
          resource.data.status in ['SIGNED', 'APPROVED'] &&
          request.resource.data.status == 'SENT_TO_EMPLOYEE' &&
          (
            request.auth.uid == resource.data.creatorId ||
            request.auth.uid in resource.data.get('reviewers', []) ||
            (exists(/databases/$(database)/documents/employees/$(request.auth.uid)) &&
              get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.get('positionId', '') in resource.data.get('reviewers', [])
            )
          ) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'employeeAckRequired',
            'employeeAckSentAt',
            'employeeAckSentBy',
            'updatedAt'
          ]) &&
          (request.resource.data.employeeAckRequired is bool) &&
          (request.resource.data.employeeAckSentAt is timestamp) &&
          (request.resource.data.employeeAckSentBy is string || request.resource.data.employeeAckSentBy == null)
        ) ||
        // Employee acknowledging SENT_TO_EMPLOYEE doc
        (
          resource.data.status == 'SENT_TO_EMPLOYEE' &&
          request.auth.uid == resource.data.employeeId &&
          request.resource.data.status == 'ACKNOWLEDGED' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'employeeAckAt',
            'employeeAckBy',
            'updatedAt'
          ]) &&
          (request.resource.data.employeeAckAt is timestamp) &&
          (request.resource.data.employeeAckBy == request.auth.uid)
        ) ||
        // Reviewer updating approval status
        (resource.data.status == 'IN_REVIEW' && 
         (request.auth.uid in resource.data.get('reviewers', []) ||
          (exists(/databases/$(database)/documents/employees/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.get('positionId', '') in resource.data.get('reviewers', []))) &&
         // Only allow updating specific fields
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approvalStatus', 'status', 'updatedAt', 'rejectionReason']))
      );
      
      // Delete: Only creator can delete their own drafts, or admins
      allow delete: if isEmployee() && (
        isAdmin() ||
        (request.auth.uid == resource.data.creatorId && resource.data.status == 'DRAFT')
      );
      // Activity Subcollection for Real-time History
      match /activity/{activityId} {
        // Read: Same as parent document (reviewers, creator, admin)
        allow read: if isEmployee() && (
            isAdmin() ||
            request.auth.uid == get(/databases/$(database)/documents/er_documents/$(documentId)).data.creatorId ||
            request.auth.uid == get(/databases/$(database)/documents/er_documents/$(documentId)).data.employeeId ||
            request.auth.uid in get(/databases/$(database)/documents/er_documents/$(documentId)).data.reviewers ||
            (exists(/databases/$(database)/documents/employees/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.get('positionId', '') in get(/databases/$(database)/documents/er_documents/$(documentId)).data.reviewers)
        );

        // Create: Reviewers, Creator, and target Employee (ack) can add logs
        allow create: if isEmployee() && (
            isAdmin() ||
            request.auth.uid == get(/databases/$(database)/documents/er_documents/$(documentId)).data.creatorId ||
            request.auth.uid in get(/databases/$(database)/documents/er_documents/$(documentId)).data.reviewers ||
            (exists(/databases/$(database)/documents/employees/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.get('positionId', '') in get(/databases/$(database)/documents/er_documents/$(documentId)).data.reviewers)
            ||
            (
              request.auth.uid == get(/databases/$(database)/documents/er_documents/$(documentId)).data.employeeId &&
              request.resource.data.keys().hasOnly(['type', 'actorId', 'content', 'createdAt']) &&
              request.resource.data.type == 'STATUS_CHANGE' &&
              request.resource.data.actorId == request.auth.uid
            )
        );
      }
    }
    
    // --- Recruitment Module Rules ---
    
    match /vacancies/{vacancyId} {
        allow read: if true; // Public read for job board (or use a cloud function for public access to be safer)
        allow write: if isAdmin();
    }
    
    match /candidates/{candidateId} {
        allow create: if true; // Public application submission
        allow read, update, delete: if isAdmin();
    }
    
    match /applications/{applicationId} {
        allow create: if true; // Public application submission
        allow read, update, delete: if isAdmin();
    }

    match /evaluation_requests/{requestId} {
        allow read: if isEmployee();
        allow create: if isEmployee();
        allow update: if isEmployee();
        allow delete: if isAdmin();
    }
    
    match /interviews/{interviewId} {
        allow read: if isEmployee();
        allow write: if isAdmin();
    }

    // --- Projects Module Rules ---
    
    // Projects - All signed-in users can read projects, admins can write
    // Project owners and assigned employees can also update
    match /projects/{projectId} {
        allow read: if isEmployee();
        allow create: if isEmployee();
        allow update: if isEmployee() && (
            isAdmin() ||
            request.auth.uid == resource.data.ownerId ||
            request.auth.uid == resource.data.createdBy
        );
        allow delete: if isAdmin() || (isEmployee() && request.auth.uid == resource.data.createdBy);
    }
    
    // Tasks subcollection under projects
    match /projects/{projectId}/tasks/{taskId} {
        allow read: if isEmployee();
        allow create: if isEmployee();
        allow update: if isEmployee() && (
            isAdmin() ||
            request.auth.uid == resource.data.ownerId ||
            request.auth.uid in resource.data.get('assigneeIds', [])
        );
        allow delete: if isAdmin() || (isEmployee() && request.auth.uid == resource.data.ownerId);
    }

    // Messages subcollection under projects (Project Chat)
    match /projects/{projectId}/messages/{messageId} {
        allow read: if isEmployee();
        allow create: if isEmployee();
        allow update: if isEmployee() && request.auth.uid == resource.data.senderId;
        allow delete: if isAdmin() || (isEmployee() && request.auth.uid == resource.data.senderId);
    }
    
    // Collection Group rules for tasks (for dashboard queries)
    match /{path=**}/tasks/{taskId} {
        allow read: if isEmployee();
    }

    // ─── Санал асуулга (Survey) ─────────────────────────────────────────
    match /surveys/{surveyId} {
        allow read: if isEmployee();
        allow create: if isEmployee();
        allow update: if isEmployee();
        allow delete: if isAdmin();
    }

    match /surveys/{surveyId}/questions/{questionId} {
        allow read: if isEmployee();
        allow create: if isEmployee();
        allow update: if isEmployee();
        allow delete: if isEmployee();
    }

    match /surveys/{surveyId}/responses/{responseId} {
        allow read: if isAdmin();
        allow create: if isEmployee();
        allow delete: if isAdmin();
    }

    match /survey_templates/{templateId} {
        allow read: if isEmployee();
        allow create: if isAdmin();
        allow update: if isAdmin();
        allow delete: if isAdmin();
    }

    // --- TMS (Тээвэр удирдлагын систем) ---
    match /tms_customers/{customerId} {
      allow read, write: if isTmsAllowed();
    }
    match /tms_customers/{customerId}/employees/{employeeId} {
      allow read, write: if isTmsAllowed();
    }

    match /tms_warehouses/{warehouseId} {
      allow read, write: if isTmsAllowed();
    }

    match /tms_drivers/{driverId} {
      // Дисптачер бүх жолоочид; жолооч өөрийн карт уншина
      allow read: if isTmsAllowed() || isOwnDriver(driverId);
      // Бүх бичилт: дисптачер. Жолооч өөрийн жижиг талбаруудыг шинэчлэх боломжтой
      allow create, delete: if isTmsAllowed();
      allow update: if isTmsAllowed()
                    || (isOwnDriver(driverId) && driverOnlyFieldsChanged(request.resource.data, resource.data));
    }
    match /tms_drivers/{driverId}/storage/{itemId} {
      allow read, write: if isTmsAllowed() || isOwnDriver(driverId);
    }
    // Жолоочийн утаснаас орох GPS цэгүүд (хязгаарлагдмал хэмжээтэй)
    match /tms_drivers/{driverId}/gps_tracks/{trackId} {
      allow read: if isTmsAllowed() || isOwnDriver(driverId);
      allow create: if isOwnDriver(driverId)
                    && request.resource.data.lat is number
                    && request.resource.data.lng is number
                    && request.resource.data.source in ['phone', 'aika168'];
      allow update, delete: if isAdmin();
    }

    match /tms_vehicles/{vehicleId} {
      // Жолооч өөрт оноогдсон машины мэдээллийг унших эрхтэй (driverId эсвэл driverIds жагсаалтын аль нэг)
      allow read: if isTmsAllowed()
                  || (isDriver() && (
                       resource.data.get('driverId', '') == getDriverId()
                       || (resource.data.get('driverIds', []) is list
                           && resource.data.get('driverIds', []).hasAny([getDriverId()]))
                     ));
      allow create, delete: if isTmsAllowed();
      // Жолооч odometer-г шинэчлэх боломжтой (зөвхөн өсгөх)
      allow update: if isTmsAllowed()
                    || (isDriver()
                        && resource.data.get('driverId', '') == getDriverId()
                        && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['odometer', 'updatedAt'])
                        && request.resource.data.get('odometer', 0) >= resource.data.get('odometer', 0));
    }
    match /tms_quotations/{quotationId} {
      allow read, write: if isTmsAllowed();
    }
    match /tms_vehicle_makes/{makeId} {
      allow read, write: if isTmsAllowed();
    }
    match /tms_vehicle_models/{modelId} {
      allow read, write: if isTmsAllowed();
    }
    match /tms_vehicle_types/{typeId} {
      allow read, write: if isTmsAllowed();
    }
    match /tms_trailer_types/{typeId} {
      allow read, write: if isTmsAllowed();
    }
    match /tms_regions/{regionId} {
      allow read, write: if isTmsAllowed();
    }
    match /tms_industries/{industryId} {
      allow read, write: if isTmsAllowed();
    }
    match /tms_packaging_types/{typeId} {
      allow read, write: if isTmsAllowed();
    }
    match /tms_service_types/{serviceId} {
      allow read, write: if isTmsAllowed();
    }
    match /tms_settings/{settingId} {
      allow read, write: if isTmsAllowed();
    }
    match /tms_transport_management/{transportId} {
      // Жолооч өөрт оноогдсон ажил эсвэл marketplace-д ил байгаа ажлыг харна
      allow read: if isTmsAllowed()
                  || (isDriver() && (
                       resource.data.get('driverId', '') == getDriverId()
                       || resource.data.get('isMarketplaceVisible', false) == true
                     ));
      allow create: if isTmsAllowed() && tmTransportValid(request.resource.data);
      // Жолооч өөрт оноогдсон transport дотор дискриминатор шинэчлэх боломжтой
      allow update: if (isTmsAllowed()
                       && tmTransportValid(request.resource.data)
                       && request.resource.data.customerId == resource.data.customerId)
                    || (isDriver()
                        && resource.data.get('driverId', '') == getDriverId()
                        && driverTransportFieldsChanged(request.resource.data, resource.data));
      allow delete: if isAdmin();
    }
    match /tms_contracts/{contractId} {
      allow read, write: if isTmsAllowed();
    }

    // ─── Машины бүртгэл (өдрийн үзлэг, түлш, odometer, засвар) ───────────
    match /tms_vehicle_maintenance/{maintId} {
      allow read: if isTmsAllowed()
                  || (isDriver() && resource.data.get('driverId', '') == getDriverId());
      allow create: if (isTmsAllowed()
                       && request.resource.data.driverId is string
                       && request.resource.data.vehicleId is string
                       && request.resource.data.type in ['daily_inspection', 'fuel_log', 'odometer', 'repair_request', 'damage_report'])
                    || (isDriver()
                        && request.resource.data.driverId == getDriverId()
                        && request.resource.data.vehicleId is string
                        && request.resource.data.type in ['daily_inspection', 'fuel_log', 'odometer', 'repair_request', 'damage_report']
                        && request.resource.data.status == 'submitted');
      // Status болон reviewerNote-ийг зөвхөн дисптачер шинэчилнэ.
      // Жолооч зөвхөн `submitted` хэвээр байсан өөрийн бүртгэлийн descriptive талбаруудыг засна
      allow update: if isTmsAllowed()
                    || (isDriver()
                        && resource.data.driverId == getDriverId()
                        && resource.data.status == 'submitted'
                        && request.resource.data.driverId == resource.data.driverId
                        && request.resource.data.vehicleId == resource.data.vehicleId
                        && request.resource.data.type == resource.data.type
                        && request.resource.data.status == 'submitted');
      allow delete: if isAdmin();
    }

    // ─── Нууц үг сэргээх (OTP) — зөвхөн Admin SDK бичиж/уншина ──────────
    // Клиент талаас ямар ч хандалтыг хориглоно (OTP hash задрахаас сэргийлнэ).
    match /password_resets/{uid} {
      allow read, write: if false;
    }

    // ─── CRM (Харилцагчийн удирдлага — Түмэн Тээх) ──────────────────────
    // crm_* collection-ууд: админ эсвэл crmAccess эрхтэй ажилтан.
    match /crm_contacts/{docId} { allow read, write: if isCrmAllowed(); }
    match /crm_companies/{docId} { allow read, write: if isCrmAllowed(); }
    match /crm_deals/{docId} { allow read, write: if isCrmAllowed(); }
    match /crm_tickets/{docId} { allow read, write: if isCrmAllowed(); }
    match /crm_activities/{docId} { allow read, write: if isCrmAllowed(); }
    match /crm_products/{docId} { allow read, write: if isCrmAllowed(); }
    match /crm_quotes/{docId} { allow read, write: if isCrmAllowed(); }
    match /crm_email_templates/{docId} { allow read, write: if isCrmAllowed(); }
    match /crm_surveys/{docId} { allow read, write: if isCrmAllowed(); }
    match /crm_carriers/{docId} { allow read, write: if isCrmAllowed(); }
    // Sheets синкийн үр дүн — энгийн хэрэглэгч зөвхөн унших; админ (client-side синк) бичиж болно.
    match /crm_orders/{docId} { allow read: if isCrmAllowed(); allow write: if isAdmin(); }
    match /crm_order_stats/{docId} { allow read: if isCrmAllowed(); allow write: if isAdmin(); }
    match /crm_company_stats/{docId} { allow read: if isCrmAllowed(); allow write: if isAdmin(); }
    match /crm_carrier_stats/{docId} { allow read: if isCrmAllowed(); allow write: if isAdmin(); }
    match /crm_settings/{docId} { allow read: if isCrmAllowed(); allow write: if isAdmin(); }
    // Аудит лог — нэмэх боломжтой, засах/устгах хориотой; унших нь админ.
    match /crm_audit/{docId} {
      allow read: if isAdmin();
      allow create: if isCrmAllowed();
      allow update, delete: if false;
    }

    // ─── ХАБЭА (HSE — Хөдөлмөрийн аюулгүй байдал, эрүүл ахуй) ───────────
    // hse_* collection-ууд: админ эсвэл hseAccess эрхтэй ажилтан унших/бичих.
    // Аюул: хариуцагч ажилтан (haritslahId) өөрт оноогдсоныг унших боломжтой (зөвхөн харах).
    match /hse_hazards/{docId} {
      allow read: if isHseAllowed() || resource.data.get('haritslahId', '') == request.auth.uid;
      allow write: if isHseAllowed();
    }
    match /hse_hazard_categories/{docId} { allow read, write: if isHseAllowed(); }
    match /hse_take5/{docId} { allow read, write: if isHseAllowed(); }
    match /hse_jha/{docId} { allow read, write: if isHseAllowed(); }
    match /hse_tasks/{docId} { allow read, write: if isHseAllowed(); }
    match /hse_incidents/{docId} { allow read, write: if isHseAllowed(); }
    match /hse_incident_reports/{docId} { allow read, write: if isHseAllowed(); }
    match /hse_incident_notices/{docId} { allow read, write: if isHseAllowed(); }
    match /hse_explanations/{docId} { allow read, write: if isHseAllowed(); }
    match /hse_incident_investigations/{docId} { allow read, write: if isHseAllowed(); }
    // Сэрэмжлүүлэг: танилцах ажилтан унших + "танилцсан" гэж өөрийгөө бүртгэх (tanilcsanIds).
    match /hse_alerts/{docId} {
      allow read: if isHseAllowed() || request.auth.uid in resource.data.get('tanilcahIds', []);
      allow create, delete: if isHseAllowed();
      allow update: if isHseAllowed() || canSelfAck('tanilcahIds', 'tanilcsanIds');
    }
    // Зөрчил: хариуцагч ажилтан унших (зөвхөн харах).
    match /hse_violations/{docId} {
      allow read: if isHseAllowed() || resource.data.get('haritslahId', '') == request.auth.uid;
      allow write: if isHseAllowed();
    }
    match /hse_violation_categories/{docId} { allow read, write: if isHseAllowed(); }
    match /hse_permits/{docId} { allow read, write: if isHseAllowed(); }
    // Сургалт: хамрагдах ажилтан унших + "хамрагдсан" гэж өөрийгөө бүртгэх (hamragdsanIds).
    match /hse_training/{docId} {
      allow read: if isHseAllowed() || request.auth.uid in resource.data.get('hamragdahIds', []);
      allow create, delete: if isHseAllowed();
      allow update: if isHseAllowed() || canSelfAck('hamragdahIds', 'hamragdsanIds');
    }
    match /hse_training_templates/{docId} { allow read, write: if isHseAllowed(); }
    // Зааварчилгаа: танилцах ажилтан унших + "танилцсан" гэж өөрийгөө бүртгэх (tanilcsanIds).
    match /hse_briefings/{docId} {
      allow read: if isHseAllowed() || request.auth.uid in resource.data.get('tanilcahIds', []);
      allow create, delete: if isHseAllowed();
      allow update: if isHseAllowed() || canSelfAck('tanilcahIds', 'tanilcsanIds');
    }
    match /hse_briefing_templates/{docId} { allow read, write: if isHseAllowed(); }
    match /hse_inspections/{docId} { allow read, write: if isHseAllowed(); }
    match /hse_inspection_checklists/{docId} { allow read, write: if isHseAllowed(); }
    match /hse_nonconformities/{docId} { allow read, write: if isHseAllowed(); }
    match /hse_ppe/{docId} { allow read, write: if isHseAllowed(); }
    match /hse_ppe_issues/{docId} { allow read, write: if isHseAllowed(); }
    match /hse_documents/{docId} { allow read, write: if isHseAllowed(); }
    match /hse_org_info/{docId} { allow read, write: if isHseAllowed(); }
    match /hse_org_config/{docId} { allow read, write: if isHseAllowed(); }
    match /hse_surveys/{docId} { allow read, write: if isHseAllowed(); }
    match /hse_videos/{docId} { allow read, write: if isHseAllowed(); }

    // ─── Marketplace — Захиалагчийн апп (mp_* collections) ──────────────
    // Захиалагчийн бүх БИЧИЛТ зөвхөн API (Admin SDK)-аар явна; доорх read
    // зөвшөөрлүүд нь зөвхөн realtime listener-ийн боломж (сонголтоор).
    // Үнийн хана: mp_orders болон quotes дээр driverPrice/driverAmount/margin
    // талбар ОГТ БАЙХГҮЙ тул захиалагч уншсан ч үнийн мэдээлэл задрахгүй.
    // offers subcollection (driverAmount агуулдаг) захиалагчид ХААЛТТАЙ.

    match /customer_users/{uid} {
      allow read: if isTmsAllowed() || (isCustomer() && request.auth.uid == uid);
      allow write: if isTmsAllowed();
    }

    match /mp_orders/{orderId} {
      allow read: if isTmsAllowed()
                  || (isCustomer() && resource.data.get('createdByUid', '') == request.auth.uid);
      allow write: if isTmsAllowed();

      // Захиалагчид харагдах, margin нэмэгдсэн үнийн саналууд
      match /quotes/{quoteId} {
        allow read: if isTmsAllowed()
                    || (isCustomer() &&
                        get(/databases/$(database)/documents/mp_orders/$(orderId))
                          .data.get('createdByUid', '') == request.auth.uid);
        allow write: if isTmsAllowed();
      }

      // Жолоочдын түүхий санал (driverAmount) — захиалагчид хэзээ ч харагдахгүй
      match /offers/{offerId} {
        allow read: if isTmsAllowed()
                    || (isDriver() && resource.data.get('driverId', '') == getDriverId());
        allow write: if isTmsAllowed();
      }
    }

    // Idempotency бүртгэл — зөвхөн Admin SDK
    match /mp_idempotency/{docId} {
      allow read, write: if false;
    }

    // Жолоочийн үнэлгээний түүх — API бичнэ, staff уншина
    match /mp_driver_ratings/{docId} {
      allow read: if isTmsAllowed();
      allow write: if false;
    }

  }
}
